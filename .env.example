# Google AI Studio key (free tier works). Without it, BreatheWise serves its deterministic explanations.
GEMINI_API_KEY=
# Optional: comma-separated Gemini models tried in order.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# Optional second provider with an OpenAI-compatible API (for example Groq's free tier).
FALLBACK_AI_URL=
FALLBACK_AI_KEY=
FALLBACK_AI_MODEL=
# Optional: AI calls allowed per server instance per day before falling back.
AI_DAILY_BUDGET=900
